@page "/"
@inject ProjectService ProjectService

<PageTitle>@content.General.SiteName — Game Developer</PageTitle>

<header class="topbar" id="top">
    <a class="brand" href="#top" aria-label="@content.General.SiteName home">
        <span class="brand-mark">@content.General.BrandMark</span>
        <span class="brand-copy">
            <strong>@content.General.SiteName</strong>
            <small>@content.General.BrandSubline</small>
        </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#games">Games</a>
        <a href="#profile">Profile</a>
        <a href="#skills">Loadout</a>
        <a href="#contact">Contact</a>
    </nav>

    <a class="status-chip" href="@($"mailto:{content.Contact.Email}")">
        <span class="status-dot"></span>
        @content.General.AvailabilityText
    </a>
</header>

<main>
    <section class="hero-section">
        <div class="hero-grid"></div>
        <div class="hero-noise"></div>

        <div class="hero-copy reveal">
            <div class="eyebrow"><span>@content.Hero.EyebrowPrefix</span> // @content.Hero.EyebrowText</div>
            <h1>
                @content.Hero.HeadingLine1
                <span class="hero-outline">@content.Hero.HeadingLine2</span>
            </h1>
            <p class="hero-lede">@content.Hero.Description</p>

            <div class="hero-actions">
                <a class="btn btn-primary" href="@content.Hero.PrimaryCtaHref">
                    <span>@content.Hero.PrimaryCtaLabel</span>
                    <span aria-hidden="true">↘</span>
                </a>
                <a class="btn btn-ghost" href="@content.Hero.SecondaryCtaHref">@content.Hero.SecondaryCtaLabel</a>
            </div>

            <div class="hero-meta">
                <div>
                    <span class="meta-label">@content.Hero.Meta1Label</span>
                    <strong>@content.Hero.Meta1Value</strong>
                </div>
                <div>
                    <span class="meta-label">@content.Hero.Meta2Label</span>
                    <strong>@content.Hero.Meta2Value</strong>
                </div>
                <div>
                    <span class="meta-label">@content.Hero.Meta3Label</span>
                    <strong>@content.Hero.Meta3Value</strong>
                </div>
            </div>
        </div>

        <div class="hero-visual reveal reveal-delay">
            <div class="signal-card">
                <div class="signal-top">
                    <span>@content.Hero.VisualTopLeft</span>
                    <span>@content.Hero.VisualTopRight</span>
                </div>

                <div class="orbital-stage" aria-hidden="true">
                    <div class="orbit orbit-a"></div>
                    <div class="orbit orbit-b"></div>
                    <div class="orbit orbit-c"></div>
                    <div class="core-glow"></div>
                    <div class="crosshair crosshair-x"></div>
                    <div class="crosshair crosshair-y"></div>
                    <div class="pixel pixel-a"></div>
                    <div class="pixel pixel-b"></div>
                    <div class="pixel pixel-c"></div>
                    <div class="pixel pixel-d"></div>
                </div>

                <div class="signal-bottom">
                    <div>
                        <span>@content.Hero.VisualBottomLabel</span>
                        <strong>@content.Hero.VisualBottomValue</strong>
                    </div>
                    <div class="signal-bars" aria-hidden="true">
                        <i></i><i></i><i></i><i></i><i></i>
                    </div>
                </div>
            </div>
            <div class="floating-tag tag-one">@content.Hero.FloatingTag1</div>
            <div class="floating-tag tag-two">@content.Hero.FloatingTag2</div>
        </div>

        <div class="scroll-cue" aria-hidden="true">
            <span>@content.Hero.ScrollLabel</span>
            <i></i>
        </div>
    </section>

    <section class="ticker" aria-label="Technology stack">
        <div class="ticker-track">
            @foreach (var item in TickerSkills)
            {
                <span>@item.ToUpperInvariant()</span><b>✦</b>
            }
        </div>
    </section>

    <section class="section projects-section" id="games">
        <div class="section-heading">
            <div>
                <div class="section-index">@content.Projects.SectionLabel</div>
                <h2>@content.Projects.Heading</h2>
            </div>
            <p>@content.Projects.Intro</p>
        </div>

        @if (isLoading)
        {
            <div class="project-grid">
                @for (var i = 0; i < 2; i++)
                {
                    <article class="project-card project-skeleton">
                        <div class="project-media"></div>
                        <div class="project-content">
                            <div class="skeleton-line wide"></div>
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line short"></div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in DisplayProjects)
                {
                    <article class="project-card">
                        <div class="project-media">
                            @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                            {
                                <img src="@project.ImageUrl" alt="Cover artwork for @project.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="project-placeholder" aria-hidden="true">
                                    <div class="placeholder-grid"></div>
                                    <span>@GetProjectInitials(project.Title)</span>
                                </div>
                            }

                            <div class="project-number">@GetProjectNumber(project)</div>
                            <div class="media-corner corner-tl"></div>
                            <div class="media-corner corner-tr"></div>
                            <div class="media-corner corner-bl"></div>
                            <div class="media-corner corner-br"></div>
                        </div>

                        <div class="project-content">
                            <div class="project-kicker">
                                <span>@content.Projects.KickerLeft</span>
                                <span>@content.Projects.KickerRight</span>
                            </div>
                            <h3>@project.Title</h3>
                            <p>@project.Description</p>

                            @if (!string.IsNullOrWhiteSpace(project.Link))
                            {
                                <a class="project-link" href="@project.Link" target="_blank" rel="noopener noreferrer">
                                    @content.Projects.LinkLabel <span>↗</span>
                                </a>
                            }
                            else
                            {
                                <span class="project-link project-link-disabled">
                                    @content.Projects.EmptyLinkLabel <span>···</span>
                                </span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="section profile-section" id="profile">
        <div class="profile-panel">
            <div class="profile-left">
                <div class="section-index">@content.About.SectionLabel</div>
                <h2>@content.About.HeadingLine1<br />@content.About.HeadingLine2</h2>
                <p>@content.About.Paragraph1</p>
                <p>@content.About.Paragraph2</p>
            </div>

            <div class="profile-stats">
                <div class="stat-card">
                    <span class="stat-index">01</span>
                    <strong>@content.About.Highlight1Title</strong>
                    <small>@content.About.Highlight1Subtitle</small>
                </div>
                <div class="stat-card">
                    <span class="stat-index">02</span>
                    <strong>@content.About.Highlight2Title</strong>
                    <small>@content.About.Highlight2Subtitle</small>
                </div>
                <div class="stat-card">
                    <span class="stat-index">03</span>
                    <strong>@content.About.Highlight3Title</strong>
                    <small>@content.About.Highlight3Subtitle</small>
                </div>
                <div class="stat-card accent-stat">
                    <span class="stat-index">04</span>
                    <strong>@content.About.Highlight4Title</strong>
                    <small>@content.About.Highlight4Subtitle</small>
                </div>
            </div>
        </div>
    </section>

    <section class="section skills-section" id="skills">
        <div class="section-heading">
            <div>
                <div class="section-index">@content.Skills.SectionLabel</div>
                <h2>@content.Skills.Heading</h2>
            </div>
        </div>

        <div class="loadout-grid">
            @{ var groupIndex = 0; }
            @foreach (var group in SkillGroups)
            {
                var letter = ((char)('A' + Math.Min(groupIndex, 25))).ToString();
                groupIndex++;
                <article class="loadout-card">
                    <span class="loadout-no">@letter</span>
                    <h3>@group.Key</h3>
                    <div class="skill-cloud">
                        @foreach (var skill in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                        {
                            <span>@skill.Name</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="section experience-section">
        <div class="experience-shell">
            <div class="section-index">@content.Experience.SectionLabel</div>

            @foreach (var item in DisplayExperience)
            {
                <article class="experience-row">
                    <div class="experience-time">@item.Period</div>
                    <div class="experience-title">
                        <span>@item.Organization</span>
                        <strong>@item.Title</strong>
                    </div>
                    <p>@item.Description</p>
                </article>
            }
        </div>
    </section>

    <section class="contact-section" id="contact">
        <div class="contact-inner">
            <div class="contact-copy">
                <div class="section-index light-index">@content.Contact.SectionLabel</div>
                <h2>@content.Contact.HeadingLine1<br />@content.Contact.HeadingLine2</h2>
            </div>

            <div class="contact-actions">
                <p>@content.Contact.Description</p>
                <a class="contact-mail" href="@($"mailto:{content.Contact.Email}")">
                    @content.Contact.Email <span>↗</span>
                </a>
                <div class="contact-location">@content.Contact.Location</div>
            </div>
        </div>

        <footer>
            <div>@content.General.FooterText</div>
            <div class="footer-center">@content.General.FooterTechText</div>
            <a href="#top">Back to spawn ↑</a>
        </footer>
    </section>
</main>

@code {
    private SiteContent content = SiteContentDefaults.Create();
    private List<ProjectItem> projects = [];
    private List<SkillItem> skills = [];
    private List<ExperienceItem> experience = [];
    private bool isLoading = true;

    private readonly List<ProjectItem> fallbackProjects =
    [
        new()
        {
            Id = -1,
            Title = "Cantilena: Whispers of the Last Song",
            Description = "A psychological horror adventure where a hearing-aid mechanic reshapes how players see, hear, explore, and survive a surreal opera world.",
            SortOrder = 1
        }
    ];

    private readonly List<SkillItem> fallbackSkills =
    [
        new() { Id = -1, Category = "Programming", Name = "C#", SortOrder = 1 },
        new() { Id = -2, Category = "Programming", Name = "Java", SortOrder = 2 },
        new() { Id = -3, Category = "Programming", Name = "GDScript", SortOrder = 3 },
        new() { Id = -4, Category = "Game engines", Name = "Unity", SortOrder = 1 },
        new() { Id = -5, Category = "Game engines", Name = "Godot", SortOrder = 2 },
        new() { Id = -6, Category = "Creative tools", Name = "Figma", SortOrder = 1 },
        new() { Id = -7, Category = "Creative tools", Name = "Premiere Pro", SortOrder = 2 },
        new() { Id = -8, Category = "Creative tools", Name = "CapCut", SortOrder = 3 }
    ];

    private readonly List<ExperienceItem> fallbackExperience =
    [
        new()
        {
            Id = -1,
            Organization = "INC Museum",
            Title = "Video Editor / LED Wall Video Editor",
            Period = "DEC 2025 — JUL 2026",
            Description = "Produced and optimized video content for exhibits, presentations, and large-format LED displays while collaborating with the creative team on visual execution.",
            SortOrder = 1
        },
        new()
        {
            Id = -2,
            Organization = "New Era University",
            Title = "BS Entertainment & Multimedia Computing",
            Period = "2022 — 2026",
            Description = "Specialized in Game Development with practical work across programming, interactive systems, creative production, and game design.",
            SortOrder = 2
        }
    ];

    private IEnumerable<ProjectItem> DisplayProjects =>
        (projects.Count > 0 ? projects : fallbackProjects)
            .OrderBy(x => x.SortOrder)
            .ThenByDescending(x => x.Id);

    private IEnumerable<SkillItem> DisplaySkills =>
        skills.Count > 0 ? skills : fallbackSkills;

    private IEnumerable<IGrouping<string, SkillItem>> SkillGroups =>
        DisplaySkills
            .GroupBy(x => x.Category)
            .OrderBy(group => group.Min(x => x.SortOrder));

    private IEnumerable<ExperienceItem> DisplayExperience =>
        (experience.Count > 0 ? experience : fallbackExperience)
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.Id);

    private IEnumerable<string> TickerSkills =>
        DisplaySkills
            .OrderBy(x => x.SortOrder)
            .Select(x => x.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10);

    protected override async Task OnInitializedAsync()
    {
        content = await ProjectService.GetContentAsync();
        projects = await ProjectService.GetProjectsAsync();
        skills = await ProjectService.GetSkillsAsync();
        experience = await ProjectService.GetExperienceAsync();
        isLoading = false;
    }

    private string GetProjectNumber(ProjectItem project)
    {
        var ordered = DisplayProjects.ToList();
        var index = ordered.FindIndex(x => x.Id == project.Id);
        return $"{index + 1:00}";
    }

    private static string GetProjectInitials(string title)
    {
        var parts = title
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(x => char.IsLetterOrDigit(x[0]))
            .Take(2)
            .Select(x => char.ToUpperInvariant(x[0]));

        var initials = string.Concat(parts);
        return string.IsNullOrWhiteSpace(initials) ? "GAME" : initials;
    }
}
